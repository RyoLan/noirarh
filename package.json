{
  "name": "noira-site",
  "version": "0.1.2",
  "private": true,
  "description": "Noira ($NOIRA) website: landing page, launch scanner, Ask Noira and the web vibecode builder.",
  "type": "module",
  "workspaces": [
    "agent",
    "desktop",
    "mobile"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:watch": "tsx watch --clear-screen=false server/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.node.json",
    "start": "node dist-node/server/index.js --prod",
    "typecheck": "tsc --noEmit",
    "check": "tsx scripts/check-agent-tools.ts",
    "agent:build": "npm run build -w agent",
    "desktop:build": "npm run dist -w desktop",
    "mobile:sync": "npm run sync -w mobile",
    "downloads:fetch": "node scripts/fetch-downloads.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "dotenv": "^18.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
