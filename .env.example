# Claude credentials. The SDK also accepts ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile.
ANTHROPIC_API_KEY=

# Optional
PORT=5173
# Ask Noira questions per visitor per day
ASK_PER_DAY=40

# Admin panel at /admin (changes the contract address and buy link). Use a long random password.
ADMIN_PASSWORD=
# Where the admin settings are saved (default ./data)
# DATA_DIR=data
